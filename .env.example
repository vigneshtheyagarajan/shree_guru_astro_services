# PostgreSQL connection string
DATABASE_URL="postgresql://user@localhost:5432/shree_guru_astro_dev?schema=public"

# NextAuth secret — generate with: openssl rand -base64 33
AUTH_SECRET=""

# Seeded admin account (prisma/seed.ts). Set a real password before running
# the seed anywhere reachable publicly — it defaults to a well-known value.
ADMIN_EMAIL="admin@shreeguruastro.com"
ADMIN_PASSWORD=""

# Shared secret cron routes require in an Authorization: Bearer header.
# Vercel Cron attaches this automatically once set as a project env var.
CRON_SECRET=""

# --- Resend (email) — https://resend.com/api-keys ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Shree Guru Astro Services <onboarding@resend.dev>"

# --- Cloudinary (file/image uploads) — https://console.cloudinary.com/settings/api-keys ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Pusher (real-time chat) — https://dashboard.pusher.com/apps ---
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# --- Razorpay (payments) — https://dashboard.razorpay.com/app/keys ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Twilio (SMS) — https://console.twilio.com ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Google — https://console.cloud.google.com/apis/credentials ---
# Same OAuth client is reused for two separate flows on this client ID:
#  1. Client "Sign in with Google" (NextAuth) -- add this redirect URI:
#     http://localhost:3000/api/auth/callback/google (+ your production URL)
#  2. Astrologer Google Calendar sync -- needs GOOGLE_CALENDAR_REDIRECT_URI
#     below added as an authorized redirect URI too.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"

# --- RazorpayX Payouts — https://x.razorpay.com (separate account_number from a RazorpayX current account) ---
RAZORPAYX_ACCOUNT_NUMBER=""

# --- Daily.co (video calling) — https://dashboard.daily.co/developers ---
DAILY_API_KEY=""
